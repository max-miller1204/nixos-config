general {
    output_format = "i3bar"
    interval = 5
    colors = true
    color_good = "#8C9440"
    color_bad = "#A54242"
    color_degraded = "#DE935F"
}

order += "disk /"
order += "ethernet ens160"
order += "memory"
order += "load"
order += "tztime local"

ethernet ens160 {
    format_up = "E: %ip"
    format_down = "E: down"
}

memory {
    format = "RAM: %used / %total"
    threshold_degraded = "10%"
    format_degraded = "RAM: %used / %total"
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}

load {
    format = "Load: %1min"
}

disk "/" {
    format = "Disk: %avail"
}
